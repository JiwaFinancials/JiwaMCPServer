{
  "JiwaAPIURL": "http://localhost",
  "JiwaAPIKey": "",
  "PageSize": 100,
  "Plugins": {
    "Enabled": true,
    "Folder": "Plugins",
    "Assemblies": []
  },
  "LocalFileSystem": {
    "AllowedRoots": [],
    "MaxReadBytes": 262144,
    "MaxWriteBytes": 262144
  },
  "DocumentIntelligence": {
    "MaxDocumentSizeBytes": 83886080,
    "MaxPages": 1200,
    "EnableBackgroundProcessing": true,
    "ChunkTargetTokens": 1200,
    "ChunkMinTokens": 1000,
    "ChunkMaxTokens": 1500,
    "ChunkOverlapTokens": 180,
    "MaxSearchResults": 10,
    "EmbeddingDimensions": 1536,
    "MinimumExtractedCharactersBeforeOcr": 40,
    "AllowedMimeTypes": [
      "application/pdf",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "text/plain",
      "text/csv",
      "application/json",
      "application/xml",
      "image/png",
      "image/jpeg",
      "image/webp"
    ],
    "AllowedFileExtensions": [
      ".pdf",
      ".docx",
      ".xlsx",
      ".txt",
      ".csv",
      ".json",
      ".xml",
      ".png",
      ".jpg",
      ".jpeg",
      ".webp"
    ],
    "Embeddings": {
      "Provider": "disabled",
      "Endpoint": "",
      "ApiKey": "",
      "Model": "text-embedding-3-small"
    },
    "AzureDocumentIntelligence": {
      "Enabled": false,
      "Endpoint": "",
      "ApiKey": "",
      "ModelId": "prebuilt-read"
    },
    "Tesseract": {
      "Enabled": false,
      "ExecutablePath": "tesseract",
      "Language": "eng"
    }
  },
  "FormNameMappings": {
    "po": "JiwaFinancials.Jiwa.JiwaPurchaseOrdersUI.PurchaseOrders",
    "purchase order": "JiwaFinancials.Jiwa.JiwaPurchaseOrdersUI.PurchaseOrders",
    "inventory": "JiwaFinancials.Jiwa.JiwaInventoryUI.InventoryMaintenanceForm",
    "inv": "JiwaFinancials.Jiwa.JiwaInventoryUI.InventoryMaintenanceForm",
    "creditor purchases batch": "JiwaFinancials.Jiwa.JiwaCRBatchTXUI.CreditorPurchases",
    "creditor purchase batch": "JiwaFinancials.Jiwa.JiwaCRBatchTXUI.CreditorPurchases",
    "creditor purchases": "JiwaFinancials.Jiwa.JiwaCRBatchTXUI.CreditorPurchases",
    "creditor purchase": "JiwaFinancials.Jiwa.JiwaCRBatchTXUI.CreditorPurchases"
  },
  "ToolRouting": {
    "EnableRouting": true,
    "EnableDomainClassification": true,
    "RetrievalTopK": 20,
    "MaxSelectedTools": 5,
    "SimilarityThreshold": 0.2,
    "EmbeddingDimensions": 768,
    "Domains": [
      "CRM",
      "ERP",
      "Procurement",
      "Finance",
      "Reporting",
      "HR",
      "Projects",
      "Documents",
      "Knowledge Base",
      "Email",
      "Calendar",
      "Customer Support"
    ]
  },
  "ToolRoutingDiagnostics": {
    "EnableDetailedLogging": true,
    "EnablePromptLogging": true,
    "EnableMetrics": true,
    "EnableDiagnosticEndpoint": true,
    "RestrictDiagnosticEndpointToLocalhost": true,
    "DiagnosticApiKeyHeaderName": "X-Tool-Routing-Diagnostics-Key",
    "DiagnosticApiKey": ""
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  }
}
