{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  "Server": {
    "ListenUrl": "http://127.0.0.1:5000"
  },
  "JiwaAPIURL": "http://localhost",
  "JiwaAPIKey": "",
  "PageSize": 100,
  "Plugins": {
    "Enabled": true,
    "Folder": "Plugins",
    "Assemblies": []
  },
  "LocalFileSystem": {
    "AllowedRoots": [ "%USERPROFILE%\\Documents\\AIChat" ],
    "MaxReadBytes": 262144,
    "MaxWriteBytes": 262144
  },
  "DocumentProcessing": {
    "MaxUploadSizeMB": 50,
    "TempFolder": "TempFiles",
    "RetentionHours": 24
  }
}
